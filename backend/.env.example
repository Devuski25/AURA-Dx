# Copy to .env.local and fill with your Supabase project credentials
# Get keys from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_API_KEY=your-inference-api-key
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=https://aura-dx.xyz
JWT_SECRET=your-jwt-secret-with-at-least-32-chars
JWT_ALGORITHM=HS256
# --- Email (OTP delivery) -----------------------------------------------
# Leave unset to use local Supabase Inbucket (requires `supabase start`;
# SMTP listens on :54325, web inbox at http://127.0.0.1:54324).
# For a real provider (Gmail app password, Brevo, Resend...), set:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
