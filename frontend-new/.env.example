# ============================================================
# AURA-Dx Frontend Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================

# Supabase project URL — e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — found in Dashboard > Settings > API
VITE_SUPABASE_ANON_KEY=

# Backend API URL (FastAPI).
#
# Production: the real Cloudflare tunnel hostname. Note there is no hyphen in
# `auradx` — the earlier value in this file read `api.aura-dx.xyz`, which is a
# different domain and does not resolve.
VITE_API_URL=https://api.auradx.xyz

# There is deliberately no VITE_INFERENCE_URL. The frontend never calls the
# inference service directly; it uploads audio to the backend, which calls
# inference on :8000. The only browser-observable difference is that a frontend
# configured to skip the backend would need one, and that is not how this app
# works.
#
# Cross-device development
# ------------------------
# Leave this as `http://localhost:8001` and the app still works from a phone or
# a second laptop on the same network. src/lib/api.ts detects a loopback value
# and, when the page itself is being served from a LAN address such as
# http://192.168.1.42:5174, substitutes that hostname — because `localhost` on a
# phone means the phone, and every request would go to a port nobody is
# listening on.
#
# A non-loopback value is always used verbatim, so production keeps pointing at
# the tunnel.
#
# Google sign-in still needs its redirect URL allowlisted in Supabase:
# Dashboard > Authentication > URL Configuration > Redirect URLs. Add
#   http://192.168.*.*:5174/auth/callback
# (and the /reset-password path) alongside whatever is there now. Supabase
# matches by host pattern, so one wildcard line covers every address the DHCP
# server hands out.
