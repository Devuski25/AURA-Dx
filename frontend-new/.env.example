# ============================================================
# AURA-Dx Frontend Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================

# Supabase project URL — e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — found in Dashboard > Settings > API
VITE_SUPABASE_ANON_KEY=

# Backend API URL (FastAPI) — prod
VITE_API_URL=https://api.aura-dx.xyz
# Inference service URL (only if the frontend ever calls it directly)
VITE_INFERENCE_URL=https://infer.aura-dx.xyz
